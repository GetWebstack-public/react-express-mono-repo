{
  "name": "react-express-mono-repo",
  "version": "1.0.0",
  "registry": {
    "mode": "local"
  },
  "services": [
    {
      "name": "react-app",
      "path": "./react-app",
      "port": 3000,
      "fileSync": true,
      "dockerfile": ".gws/Dockerfile",
      "watch": [
        { "actions": ["rebuildImage"], "patterns": ["package.json", "package-lock.json"] }
      ],
      "fileSyncIgnore": ["node_modules/", "build/", ".next/", ".turbo/", "coverage/", "*.log"]
    },
    {
      "name": "express-server",
      "path": "./express-server",
      "port": 3001,
      "fileSync": true,
      "dockerfile": ".gws/Dockerfile",
      "watch": [
        { "actions": ["rebuildImage"], "patterns": ["package.json", "package-lock.json"] }
      ],
      "fileSyncIgnore": ["node_modules/", "dist/", "build/", "coverage/", "*.log"]
    }
  ],
  "fileSyncIgnore": ["/.git", "/.idea", "/.vscode", "/.DS_Store"]
}
